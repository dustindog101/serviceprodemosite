---
import '@fontsource-variable/outfit';
import '@fontsource-variable/geist';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { localBusiness } from '../data/schema';

interface Props { title: string; description: string; schema?: object[]; noindex?: boolean }
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const graph = [localBusiness(), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b1b2e" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <!-- TODO(client): add a 1200x630 PNG og:image (e.g. crew + van photo) once real photography exists. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
