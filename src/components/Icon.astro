---
const { name } = Astro.props as { name: string };
const paths: Record<string, string> = {
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
  water: 'M12 2.5c3.6 4.5 6.5 7.8 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 10.3 8.4 7 12 2.5z',
  fire: 'M12 2c1 3.5 5.5 6 5.5 11a5.5 5.5 0 0 1-11 0c0-2 .8-3.4 2-4.6.2 1.6.9 2.4 1.8 2.8C10 8 10.6 4.8 12 2z',
  mold: 'M12 3a3 3 0 0 1 3 3 3 3 0 0 1 3 3 3 3 0 0 1 1 5.5A3.5 3.5 0 0 1 15.5 18H8.5A3.5 3.5 0 0 1 5 14.5 3 3 0 0 1 6 9a3 3 0 0 1 3-3 3 3 0 0 1 3-3z',
  build: 'M3 21V10l9-7 9 7v11h-6v-6H9v6H3z',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  shield: 'M12 2.5l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10v-6l8-3z',
  clock: 'M12 7v5l3.5 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
};
const stroke = ['check','clock','arrow','menu','close','mail'].includes(name);
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill={stroke ? 'none' : 'currentColor'} stroke={stroke ? 'currentColor' : 'none'}
  stroke-width={stroke ? 2.2 : undefined} stroke-linecap="round" stroke-linejoin="round">
  <path d={paths[name]} />
</svg>
